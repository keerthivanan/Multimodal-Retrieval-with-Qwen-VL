# --- SECRETS: never commit these ---
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- generated artifacts ---
# NOTE: data/index (captions) + data/pages (thumbnails) ARE committed so the
# app runs on a GPU-less host (Render) without re-ingesting via Ollama.
data/uploads/
data/test_*
reports/*.tmp

# --- python / env ---
__pycache__/
*.pyc
.venv/
venv/

# --- os / editor ---
.DS_Store
Thumbs.db
