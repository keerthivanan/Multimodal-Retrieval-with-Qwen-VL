# Copy to .env and fill in. NEVER commit your real .env (it is git-ignored).
# Every value has a safe default — with NO .env at all the app runs in mock mode.

# --- Embeddings -------------------------------------------------------------
# Priority is automatic: OpenAI (if key) -> local Ollama embeddings -> mock.
# So with NO key but Ollama running, you still get REAL semantic search, free.
OPENAI_API_KEY=                       # optional; leave empty to use local
OPENAI_EMBED_MODEL=text-embedding-3-small
# Local open-source embedding model (used when no OpenAI key). Top-tier,
# beats OpenAI ada-002 on MTEB. Pull it: `ollama pull mxbai-embed-large`.
OLLAMA_EMBED_MODEL=mxbai-embed-large

# --- Vision-Language Model (image captioning / rerank) ----------------------
# Qwen-VL is primary at every tier. Order: local Ollama -> hosted Qwen-VL API
# -> OpenAI (last resort) -> mock.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
# Hosted Qwen-VL keeps image queries on Qwen-VL in the cloud (Ollama needs a GPU
# it won't have on Render). Get a key from OpenRouter (openrouter.ai) or DashScope.
QWEN_VL_API_KEY=
QWEN_VL_BASE_URL=https://openrouter.ai/api/v1
QWEN_VL_MODEL=qwen/qwen-2.5-vl-7b-instruct

# --- Retrieval --------------------------------------------------------------
TOP_K=5
CHUNK_CHARS=500
